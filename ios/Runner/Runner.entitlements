<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Without an aps-environment entitlement
	     iOS never issues a device token, so OneSignal registers the user but
	     no notification can ever be delivered.

	     "development" is correct here even for App Store builds: Xcode rewrites
	     the value to "production" when the app is archived and signed with a
	     distribution profile. Hardcoding "production" instead breaks push on
	     every debug run against a development profile. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
